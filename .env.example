# Kopieren nach .env und anpassen. Alle Werte sind optional.

# files (Standard): Markdown-Dateien + Fotos in DATA_DIR, am besten ein eigenes, privates Git-Repo
# sqlite: echte Datenbank (eine Datei), Fotos als Dateien in DATA_DIR
STORAGE=files

# Datenverzeichnis, relativ zum Code-Repo oder absolut. Standard: data/ (ist in .gitignore)
DATA_DIR=data

# Nur bei STORAGE=sqlite: Datenbank-Datei. Standard: DATA_DIR/fashion-tracker.db
# DATABASE_FILE=data/fashion-tracker.db

# Server-Betrieb (setzt das NixOS-Modul selbst):
# GIT_AUTOSYNC=1       Datenänderungen der Website committen und pushen (nur STORAGE=files mit Git-Repo)
# CODE_AUTOUPDATE=1    neuen Code aus diesem Checkout holen und im Hintergrund bauen
# GIT_SYNC_MINUTES=15  höchstens so oft bei Benutzung abgleichen
# CACHE_DIR=.cache     Cache für das KI-Modell zum Freistellen
